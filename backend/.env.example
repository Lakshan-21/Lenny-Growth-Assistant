# Copy to .env and fill in real values. See README.md for setup.

# --- App ---------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
# Dev-only: bypass JWT verification with a fixed dev user. Never true outside local dev.
DEV_AUTH_BYPASS=false

# --- Database (Supabase PostgreSQL + pgvector) --------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres

# --- Supabase Auth -------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# --- Providers: Ollama (primary) -----------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_GENERATION_MODEL=llama3.1
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_REQUEST_TIMEOUT_SECONDS=30.0
# Forces bge-m3 embedding inference onto CPU (Ollama options.num_gpu=0) so
# the generation model keeps exclusive GPU residency instead of the two
# models evicting each other on every request. Set false only if your GPU
# has enough VRAM to hold both models resident at once.
OLLAMA_EMBEDDING_FORCE_CPU=true

# --- Knowledge: transcript ingestion --------------------------------------
TRANSCRIPT_INGESTION_DIR=./transcripts

# --- Providers: Anthropic (secondary / fallback) --------------------------
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_REQUEST_TIMEOUT_SECONDS=30.0
